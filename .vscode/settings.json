{
  // Format and fix on save, using the repository's own Prettier and ESLint rather than
  // whatever the editor defaults to. Without this, saving a file can undo the exact
  // formatting the pre-commit hook is about to enforce.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "editor.rulers": [100],

  "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },
  "[dart]": { "editor.defaultFormatter": "Dart-Code.dart-code" },

  // Use the TypeScript version pinned in the repository, not the one bundled with the
  // editor, so the editor and the command line agree about what compiles.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  "eslint.useFlatConfig": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "packages/tokens/dist": true
  },

  // The REST Client extension reads these when running requests.http.
  "rest-client.environmentVariables": {
    "$shared": { "baseUrl": "http://localhost:3000/api/v1" },
    "local": { "password": "Dev!2026" }
  }
}
