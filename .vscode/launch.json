{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug", "-w", "@mzazicare/api"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Attach to API",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug the current test file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test",
        "-w",
        "@mzazicare/api",
        "--",
        "--runInBand",
        "${fileBasename}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Mobile: Android emulator",
      "type": "dart",
      "request": "launch",
      "program": "apps/mobile/lib/main.dart",
      "cwd": "apps/mobile",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:3000/api/v1"]
    },
    {
      "name": "Mobile: iOS Simulator",
      "type": "dart",
      "request": "launch",
      "program": "apps/mobile/lib/main.dart",
      "cwd": "apps/mobile",
      "args": ["--dart-define=API_BASE_URL=http://localhost:3000/api/v1"]
    }
  ]
}
