{
  "meta": {
    "name": "MzaziCare Design Tokens",
    "version": "0.2.0",
    "note": "Edit this file only. Everything in dist/ is generated by src/build.mjs."
  },

  "primitives": {
    "paper": "#FFFFFF",
    "ink-900": "#0E1418",
    "ink-800": "#1B242A",
    "ink-700": "#2E3B42",
    "ink-600": "#47565E",
    "ink-500": "#64757D",
    "ink-400": "#8A9AA1",
    "ink-300": "#B4C0C5",
    "ink-200": "#D7DFE2",
    "ink-100": "#E8EDEF",
    "ink-50": "#F5F8F9",
    "red-900": "#5C0A11",
    "red-800": "#7D0E18",
    "red-700": "#9B0F1C",
    "red-600": "#B3111F",
    "red-500": "#D11F2C",
    "red-100": "#FBDBDD",
    "red-50": "#FEF2F3",
    "amber-800": "#7A3E00",
    "amber-700": "#95500A",
    "amber-100": "#FDECC8",
    "amber-50": "#FFF8EB",
    "green-800": "#0B5138",
    "green-700": "#0F6B4A",
    "green-100": "#CDEBDD",
    "green-50": "#EFF9F4",
    "blue-800": "#123A87",
    "blue-700": "#1A4FB0",
    "blue-100": "#DBE6FA",
    "blue-50": "#F0F5FE",
    "dark-bg": "#0B1014",
    "dark-surface": "#141C21",
    "dark-sunk": "#0F1519",
    "dark-text": "#EDF2F3",
    "dark-text-soft": "#AFBDC3",
    "dark-text-faint": "#9BABB2",
    "dark-line": "#2C383F",
    "dark-line-soft": "#1F2A30",
    "dark-accent": "#F08A92",
    "dark-focus": "#8AB4FF",
    "dark-amber-bg": "#32220A",
    "dark-amber-fg": "#FBD79A",
    "dark-amber-bd": "#6B4A15",
    "dark-blue-bg": "#121F38",
    "dark-blue-fg": "#B7CEF8",
    "dark-blue-bd": "#35528F",
    "dark-red-bg": "#2E1215",
    "dark-red-fg": "#FBBFC4",
    "dark-green-bg": "#08281C",
    "dark-green-fg": "#9CE0BE",
    "dark-green-bd": "#26674C",
    "dark-neutral-bg": "#1E282E",
    "dark-neutral-fg": "#C3CFD4",
    "dark-neutral-bd": "#46545C"
  },

  "themes": {
    "light": {
      "bg": "$ink-50",
      "surface": "$paper",
      "surfaceSunk": "$ink-100",
      "text": "$ink-900",
      "textSoft": "$ink-600",
      "textFaint": "$ink-500",
      "textDisabled": "$ink-400",
      "line": "$ink-200",
      "lineSoft": "$ink-100",
      "emergency": "$red-700",
      "emergencyPressed": "$red-800",
      "emergencyEdge": "$red-500",
      "onEmergency": "$paper",
      "focus": "$blue-700",
      "timer": "$red-700",
      "pillTriggeredBg": "$red-700",
      "pillTriggeredFg": "$paper",
      "pillTriggeredBd": "$red-700",
      "pillNotifiedBg": "$amber-50",
      "pillNotifiedFg": "$amber-800",
      "pillNotifiedBd": "$amber-100",
      "pillAcknowledgedBg": "$blue-50",
      "pillAcknowledgedFg": "$blue-800",
      "pillAcknowledgedBd": "$blue-100",
      "pillEscalatedBg": "$red-50",
      "pillEscalatedFg": "$red-800",
      "pillEscalatedBd": "$red-500",
      "pillResolvedBg": "$green-50",
      "pillResolvedFg": "$green-800",
      "pillResolvedBd": "$green-100",
      "pillCancelledBg": "$ink-100",
      "pillCancelledFg": "$ink-700",
      "pillCancelledBd": "$ink-200"
    },
    "dark": {
      "bg": "$dark-bg",
      "surface": "$dark-surface",
      "surfaceSunk": "$dark-sunk",
      "text": "$dark-text",
      "textSoft": "$dark-text-soft",
      "textFaint": "$dark-text-faint",
      "textDisabled": "$ink-500",
      "line": "$dark-line",
      "lineSoft": "$dark-line-soft",
      "emergency": "$red-700",
      "emergencyPressed": "$red-800",
      "emergencyEdge": "$red-500",
      "onEmergency": "$paper",
      "focus": "$dark-focus",
      "timer": "$dark-accent",
      "pillTriggeredBg": "$red-700",
      "pillTriggeredFg": "$paper",
      "pillTriggeredBd": "$red-500",
      "pillNotifiedBg": "$dark-amber-bg",
      "pillNotifiedFg": "$dark-amber-fg",
      "pillNotifiedBd": "$dark-amber-bd",
      "pillAcknowledgedBg": "$dark-blue-bg",
      "pillAcknowledgedFg": "$dark-blue-fg",
      "pillAcknowledgedBd": "$dark-blue-bd",
      "pillEscalatedBg": "$dark-red-bg",
      "pillEscalatedFg": "$dark-red-fg",
      "pillEscalatedBd": "$red-500",
      "pillResolvedBg": "$dark-green-bg",
      "pillResolvedFg": "$dark-green-fg",
      "pillResolvedBd": "$dark-green-bd",
      "pillCancelledBg": "$dark-neutral-bg",
      "pillCancelledFg": "$dark-neutral-fg",
      "pillCancelledBd": "$dark-neutral-bd"
    }
  },

  "type": {
    "family": {
      "sans": "IBM Plex Sans",
      "display": "Archivo",
      "mono": "IBM Plex Mono"
    },
    "elder": { "display": 56, "title": 32, "body": 22, "label": 20 },
    "standard": { "display": 32, "h1": 28, "h2": 22, "body": 16, "small": 14, "micro": 12 },
    "minBodySize": { "elder": 20, "standard": 14 },
    "minTouchTarget": { "elder": 72, "standard": 48 }
  },

  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "input": 4, "card": 8, "sheet": 12, "pill": 999, "elderInput": 8, "elderCard": 16 },
  "elevation": { "flat": 0, "card": 1, "dialog": 2 },
  "motion": { "state": 120, "sheet": 200, "escalation": 320 },

  "contrastTargets": [
    { "theme": "light", "fg": "text", "bg": "surface", "min": 7, "why": "body text, AAA" },
    {
      "theme": "light",
      "fg": "text",
      "bg": "bg",
      "min": 7,
      "why": "body text on app background, AAA"
    },
    { "theme": "light", "fg": "textSoft", "bg": "surface", "min": 7, "why": "secondary text, AAA" },
    { "theme": "light", "fg": "textFaint", "bg": "surface", "min": 4.5, "why": "captions, AA" },
    {
      "theme": "light",
      "fg": "onEmergency",
      "bg": "emergency",
      "min": 7,
      "why": "panic control label, AAA"
    },
    { "theme": "light", "fg": "focus", "bg": "surface", "min": 3, "why": "focus ring, non-text" },
    {
      "theme": "light",
      "fg": "pillTriggeredFg",
      "bg": "pillTriggeredBg",
      "min": 4.5,
      "why": "TRIGGERED pill"
    },
    {
      "theme": "light",
      "fg": "pillNotifiedFg",
      "bg": "pillNotifiedBg",
      "min": 4.5,
      "why": "NOTIFIED pill"
    },
    {
      "theme": "light",
      "fg": "pillAcknowledgedFg",
      "bg": "pillAcknowledgedBg",
      "min": 4.5,
      "why": "ACKNOWLEDGED pill"
    },
    {
      "theme": "light",
      "fg": "pillEscalatedFg",
      "bg": "pillEscalatedBg",
      "min": 4.5,
      "why": "ESCALATED pill"
    },
    {
      "theme": "light",
      "fg": "pillResolvedFg",
      "bg": "pillResolvedBg",
      "min": 4.5,
      "why": "RESOLVED pill"
    },
    {
      "theme": "light",
      "fg": "pillCancelledFg",
      "bg": "pillCancelledBg",
      "min": 4.5,
      "why": "CANCELLED pill"
    },
    { "theme": "dark", "fg": "text", "bg": "surface", "min": 7, "why": "body text, AAA" },
    {
      "theme": "dark",
      "fg": "text",
      "bg": "bg",
      "min": 7,
      "why": "body text on app background, AAA"
    },
    { "theme": "dark", "fg": "textSoft", "bg": "surface", "min": 7, "why": "secondary text, AAA" },
    {
      "theme": "dark",
      "fg": "textFaint",
      "bg": "surface",
      "min": 7,
      "why": "captions, raised to AAA in v0.2"
    },
    {
      "theme": "dark",
      "fg": "onEmergency",
      "bg": "emergency",
      "min": 7,
      "why": "panic control label, AAA"
    },
    { "theme": "dark", "fg": "focus", "bg": "surface", "min": 3, "why": "focus ring, non-text" },
    { "theme": "dark", "fg": "timer", "bg": "surface", "min": 4.5, "why": "timer numerals" },
    {
      "theme": "dark",
      "fg": "emergencyEdge",
      "bg": "surface",
      "min": 3,
      "why": "ESCALATED outline, meaningful boundary"
    },
    {
      "theme": "dark",
      "fg": "pillTriggeredFg",
      "bg": "pillTriggeredBg",
      "min": 4.5,
      "why": "TRIGGERED pill"
    },
    {
      "theme": "dark",
      "fg": "pillNotifiedFg",
      "bg": "pillNotifiedBg",
      "min": 4.5,
      "why": "NOTIFIED pill"
    },
    {
      "theme": "dark",
      "fg": "pillAcknowledgedFg",
      "bg": "pillAcknowledgedBg",
      "min": 4.5,
      "why": "ACKNOWLEDGED pill"
    },
    {
      "theme": "dark",
      "fg": "pillEscalatedFg",
      "bg": "pillEscalatedBg",
      "min": 4.5,
      "why": "ESCALATED pill"
    },
    {
      "theme": "dark",
      "fg": "pillResolvedFg",
      "bg": "pillResolvedBg",
      "min": 4.5,
      "why": "RESOLVED pill"
    },
    {
      "theme": "dark",
      "fg": "pillCancelledFg",
      "bg": "pillCancelledBg",
      "min": 4.5,
      "why": "CANCELLED pill"
    }
  ]
