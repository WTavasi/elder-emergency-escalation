# Copy to backend/.env and fill in. The Prisma CLI resolves .env relative to the
# workspace it runs in, so the repository root is the wrong place for it.
# .env is gitignored at every level and must never be committed.
#
# Do NOT copy this to the repository root. The root .env is read by Docker
# Compose alone and holds only POSTGRES_PORT and REDIS_PORT. A second copy of
# the secrets there is a duplicate source of truth and drifts out of step with
# this one, which is how the database port and DATABASE_URL last disagreed.

NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml).
# If you changed POSTGRES_PORT in the repository-root .env, change the port here too.
DATABASE_URL=postgresql://mzazicare:mzazicare@localhost:5432/mzazicare

# Redis (escalation timers and BullMQ)
REDIS_URL=redis://localhost:6379

# Auth: self-issued JWT. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Notification providers. "logging" writes what would have been sent and reports
# success, which lets the whole escalation chain run without credentials. Starting in
# production with it is refused, because an emergency system that silently sends
# nothing is worse than one that fails loudly.
PUSH_PROVIDER=logging
SMS_PROVIDER=logging

# Firebase Cloud Messaging: path to the service account JSON. A relative path is tried
# against the API's working directory first, then against the repository root, so
# ./credentials/fcm-service-account.json works whether the API is started from the repo
# root, from backend, or from a deployment host with its own working directory.
FCM_SERVICE_ACCOUNT_PATH=./credentials/fcm-service-account.json

# Africa's Talking. In the sandbox the username is always the literal "sandbox", and
# messages reach their web simulator rather than real handsets, which needs no
# registered number and costs nothing. Leave AT_SENDER_ID empty: the sandbox rejects a
# custom sender id, and a live account without one falls back to a shared shortcode.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Answering an alert by text ("Reply 1 if you can go, 2 if you cannot"). Off while
# SMS_INBOUND_TOKEN is empty. To try it, set both for a run rather than here, for
# example SMS_INBOUND_TOKEN=a-long-random-string AT_SHORTCODE=12345 npm run dev, and give
# Africa's Talking the callback https://<your-ngrok-domain>/api/v1/sms/inbound?token=...
AT_SHORTCODE=
SMS_INBOUND_TOKEN=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Address search, used when a caregiver sets an elder's home. OpenStreetMap's public
# Nominatim by default, called only from the API. Its usage policy asks for a contact
# in the User-Agent: put an email address you read here. Policy:
# https://operations.osmfoundation.org/policies/nominatim/
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT=
GEOCODER_COUNTRY_CODES=ke

# A responder's time to the elder while they share their way there. "estimate" needs
# nothing from outside; "osrm" asks a router and falls back to the estimate. Switch it
# on per run (ROUTING_PROVIDER=osrm npm run dev) rather than here.
ROUTING_PROVIDER=estimate
ROUTING_URL=https://router.project-osrm.org
ARRIVAL_RADIUS_METRES=100

# Google sign-in on the administrator console. A Web application OAuth client ID from
# Google Cloud Console, with the console's address (http://localhost:5173 in
# development) as an authorised JavaScript origin. Not a secret. Leave empty for no
# Google button. Only an administrator whose account has that Gmail address can use it.
GOOGLE_CLIENT_ID=

# How long a sign-up code sent by SMS stays valid, seconds.
VERIFICATION_CODE_TTL_SECONDS=600

# Escalation defaults, seconds. Overridable per tier in the escalation_rules table.
ESCALATION_TIER1_TIMEOUT=120
ESCALATION_TIER2_TIMEOUT=180
CANCEL_GRACE_WINDOW=10

# The acknowledgement time the system is evaluated against, seconds. Reported by
# the administrator dashboard as the percentage of emergencies answered within it.
RESPONSE_TARGET_SECONDS=300

# Bound how long we wait for a notification provider, milliseconds. Node's fetch has
# no default timeout, so without this a stalled connection holds a queued job.
PROVIDER_TIMEOUT_MS=10000

# Rate limiting, backed by Redis. Leave on. Turn it off only if a demonstration run
# trips the sign-in limit, and turn it back on afterwards.
RATE_LIMIT_ENABLED=true

# Retention sweeps. RETENTION_ENABLED=false stops the scheduled deletion without

# Escalation reconciliation sweep. The primary mechanism is a Redis key whose expiry the
# listener turns into an escalation; this reconciles the durable deadlines against the
# clock as well, so promotion still happens if keyspace expiry events never arrive. That
# matters on a managed Redis, where `notify-keyspace-events Ex` may not be settable by a
# client. The interval is the worst-case escalation delay in that situation, so it is a
# latency budget rather than a housekeeping figure.
# Set ESCALATION_SWEEP_ENABLED=false for the integration suite, which has to prove the
# event-driven path rather than let the sweep cover for it.
ESCALATION_SWEEP_ENABLED=true
ESCALATION_SWEEP_INTERVAL_MS=15000
# changing the windows themselves.
RETENTION_ENABLED=true
RETENTION_INTERVAL_HOURS=24

# Data retention, days. Enforced by a scheduled job and disclosed in the privacy notice.
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_RESOLVED_EVENT_DAYS=365

# Severity policy. Factor weights live in the severity_factors table and are edited by
# an administrator; these are the measurement boundaries those factors are scored against.
NIGHT_START_HOUR=22
NIGHT_END_HOUR=6
AWAY_FROM_HOME_METRES=250
RECENT_ACTIVITY_HOURS=6

# Severity bands, inclusive lower bounds on the weighted score (0 to 100).
SEVERITY_ELEVATED_FROM=35
SEVERITY_CRITICAL_FROM=60

# Password hashing: scrypt parameters. Raising N invalidates nothing, since the
# parameters are stored alongside each hash.
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1
