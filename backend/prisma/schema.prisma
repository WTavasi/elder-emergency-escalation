// MzaziCare escalation framework, database schema.
//
// Derived from the Chapter 4 Entity Relationship Diagram (Figure 4.4). Tables use
// snake_case, Prisma models use PascalCase and fields camelCase, which is the naming
// convention difference already documented in the ERD notes.
//
// Where this schema goes beyond Figure 4.4, it is marked EXTENSION and listed in
// docs/schema-extensions.md, so Chapter 4 can be brought back into agreement with it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations. Figure 4.4 leaves types to the schema figure in Section 4.4.1;
// these are that decision.
// ---------------------------------------------------------------------------

enum Role {
  ELDER
  CAREGIVER
  FAMILY_MEMBER
  EMERGENCY_RESPONDER
  ADMINISTRATOR
  /// EXTENSION. A vetted volunteer who may be asked to go to an elder near their home
  /// area: only while available, only for an elder who agreed, and told who and where
  /// only once they accept.
  COMMUNITY_RESPONDER

  @@map("role")
}

/// Operational dependency level, set by a caregiver at registration. Deliberately
/// not a clinical field: it records how much help the person needs day to day, not
/// any diagnosis, which keeps the system clear of health data under the Kenya Data
/// Protection Act 2019.
enum CareLevel {
  INDEPENDENT
  ASSISTED
  HIGH_DEPENDENCY

  @@map("care_level")
}

enum EventState {
  TRIGGERED
  NOTIFIED
  ACKNOWLEDGED
  /// EXTENSION. The person who took it on is with the elder. Reached by "I'm here" or
  /// by their shared position coming within the arrival radius.
  ON_SCENE
  ESCALATED
  RESOLVED
  CANCELLED

  @@map("event_state")
}

enum Severity {
  STANDARD
  ELEVATED
  CRITICAL

  @@map("severity")
}

enum EventOutcome {
  FALSE_ALARM
  CANCELLED_BY_ELDER
  HANDLED_AT_HOME
  RESPONDER_ATTENDED
  HOSPITAL_TRANSFER
  NO_RESPONSE

  /// EXTENSION. None of the above, with the real reason in outcome_note.
  ///
  /// A fixed list of outcomes is what makes them countable for the response-time and
  /// escalation-depth figures, and a free-text field would have destroyed that. This is
  /// the compromise: the list stays closed and countable, and the cases it does not cover
  /// are recorded honestly in one place instead of being forced into the nearest wrong
  /// option. An OTHER that keeps appearing is evidence the list needs another value.
  OTHER

  @@map("event_outcome")
}

enum NotificationChannel {
  PUSH
  SMS

  @@map("notification_channel")
}

/// EXTENSION. Figure 4.4 tracks dispatch with timestamps alone. An explicit status
/// is needed because the SMS fallback triggers on push failure, which a null
/// delivered_at cannot distinguish from "not yet delivered".
enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  ACKNOWLEDGED

  @@map("notification_status")
}

enum DispatchMode {
  SEQUENTIAL
  PARALLEL

  @@map("dispatch_mode")
}

enum AuditAction {
  EVENT_CREATED
  SEVERITY_EVALUATED
  TIER_DISPATCHED
  NOTIFICATION_FAILED
  ACKNOWLEDGED
  DECLINED
  ESCALATED
  RESPONDER_REQUESTED
  /// EXTENSION. The owner reached the elder.
  ARRIVED
  /// EXTENSION. Somebody joined the emergency's voice room. Who and when; never what was said.
  VOICE_JOINED
  /// EXTENSION. The elder answered the daily check-in this alert was raised for, late.
  CHECKED_IN_LATE
  /// EXTENSION. Community volunteers near the alert were asked, how many and why.
  VOLUNTEERS_ASKED
  /// EXTENSION. A community volunteer said they would go. The first one only.
  VOLUNTEER_ACCEPTED
  /// EXTENSION. The volunteer who accepted can no longer go.
  VOLUNTEER_WITHDREW
  /// EXTENSION. The volunteer reached the elder.
  VOLUNTEER_ARRIVED
  REOPENED
  RESOLVED
  CANCELLED

  @@map("audit_action")
}

enum ConsentType {
  DATA_PROCESSING
  LOCATION_SHARING
  CONTACT_SHARING
  /// EXTENSION. Vetted community volunteers near the elder may be asked to go in an
  /// emergency, and the one who accepts is told the elder's name and address.
  COMMUNITY_HELP

  @@map("consent_type")
}

// ---------------------------------------------------------------------------
// users. All five roles in one table, distinguished by role, which is the
// flattened class hierarchy recorded in the class diagram.
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @map("user_id") @db.Uuid
  name         String   @db.VarChar(120)
  phone        String   @unique @db.VarChar(20)
  email        String?  @unique @db.VarChar(160)
  role         Role
  passwordHash String   @map("password_hash") @db.VarChar(255)
  timezone     String   @default("Africa/Nairobi") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// EXTENSION. SHA-256 of the current refresh token, never the token itself, so a
  /// stolen database yields no usable sessions. Null means signed out everywhere.
  /// One value per user, which matches the one-device-per-user simplification.
  refreshTokenHash      String?   @map("refresh_token_hash") @db.VarChar(64)
  refreshTokenUpdatedAt DateTime? @map("refresh_token_updated_at") @db.Timestamptz(3)

  /// EXTENSION. Push target for Firebase Cloud Messaging. One device per user in
  /// this build; a devices table is the obvious later change.
  pushToken          String?   @map("push_token") @db.VarChar(255)
  pushTokenUpdatedAt DateTime? @map("push_token_updated_at") @db.Timestamptz(3)

  /// EXTENSION. When an administrator deactivated the account, null while it is active.
  /// A deactivated account cannot sign in and is never sent an emergency. Deactivated
  /// rather than deleted, because the account is named in emergency history that has to
  /// stay readable: who raised it, who answered it.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)

  // --- elder-only columns, null for every other role ---
  /// EXTENSION. Severity input. See CareLevel.
  careLevel        CareLevel? @map("care_level")
  homeLatitude     Decimal?   @map("home_latitude") @db.Decimal(9, 6)
  homeLongitude    Decimal?   @map("home_longitude") @db.Decimal(9, 6)
  homeAddressLabel String?    @map("home_address_label") @db.VarChar(200)

  /// EXTENSION. Where this elder is staying, when that is not their registered home.
  /// Null is the normal case and means at home.
  ///
  /// A deliberate alternative to reading the device's location. The app never asks for
  /// GPS and never sends a coordinate, so there is no continuous location trail to
  /// protect, disclose or explain to a participant. Instead a caregiver records a stay
  /// away from home when one actually happens, and alerts raised during it carry that
  /// place. The away-from-home severity factor measures against homeLatitude and
  /// homeLongitude, which never move, so the factor still scores.
  currentLatitude     Decimal?  @map("current_latitude") @db.Decimal(9, 6)
  currentLongitude    Decimal?  @map("current_longitude") @db.Decimal(9, 6)
  currentPlaceLabel   String?   @map("current_place_label") @db.VarChar(200)
  currentPlaceSetAt   DateTime? @map("current_place_set_at") @db.Timestamptz(3)
  /// Who recorded the stay. A plain column rather than a relation: a self-relation on
  /// User for one accountability breadcrumb would complicate every query that touches
  /// an account, and nothing joins on this.
  currentPlaceSetById String?   @map("current_place_set_by_id") @db.Uuid

  // --- emergency-responder-only columns, null for every other role ---
  // coverage_area from Figure 4.4, given physical form as a named area plus a
  // circle. Matching an alert to a responder is a Haversine distance test against
  // coverage_radius_km, which avoids taking on PostGIS for one query.
  coverageAreaName  String?  @map("coverage_area_name") @db.VarChar(120)
  coverageLatitude  Decimal? @map("coverage_latitude") @db.Decimal(9, 6)
  coverageLongitude Decimal? @map("coverage_longitude") @db.Decimal(9, 6)
  coverageRadiusKm  Decimal? @map("coverage_radius_km") @db.Decimal(6, 2)

  // --- relations ---
  triggeredEvents    EmergencyEvent[]  @relation("triggeredBy")
  acknowledgedEvents EmergencyEvent[]  @relation("acknowledgedBy")
  assignmentsAsElder CareAssignment[]  @relation("assignmentElder")
  assignmentsAsCarer CareAssignment[]  @relation("assignmentResponder")
  notifications      Notification[]
  auditLogs          AuditLog[]
  consentsAboutMe    ConsentRecord[]   @relation("consentSubject")
  consentsIGranted   ConsentRecord[]   @relation("consentGrantor")
  invitationsAsElder ChainInvitation[] @relation("invitationElder")
  invitationsSent    ChainInvitation[] @relation("invitationSender")
  preferences        UserPreference?
  checkInSchedule    CheckInSchedule?  @relation("checkInScheduleElder")
  checkInSchedulesSet CheckInSchedule[] @relation("checkInScheduleSetBy")
  checkIns           CheckIn[]
  volunteerProfile   VolunteerProfile? @relation("volunteerProfile")
  volunteersReviewed VolunteerProfile[] @relation("volunteerReviewer")
  volunteerCalls     VolunteerCall[]
  volunteeredEvents  EmergencyEvent[]  @relation("eventVolunteer")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// care_assignments. The escalation chain, ranked by priority_order. Several people
// may share a rank, and everybody at a rank is asked together: an elder's family
// is usually more than one person.
// ---------------------------------------------------------------------------

model CareAssignment {
  id            String   @id @default(uuid()) @map("assignment_id") @db.Uuid
  elderlyId     String   @map("elderly_id") @db.Uuid
  responderId   String   @map("responder_id") @db.Uuid
  priorityOrder Int      @map("priority_order") @db.SmallInt
  assignedAt    DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  /// EXTENSION. Reserved for declared cover hours, not verified presence. Not read in
  /// this build: the caregiver-cover severity factor was dropped because nothing lets
  /// a caregiver declare them (docs/decisions.md). Days are 0 for Sunday through 6 for
  /// Saturday; minutes are counted from local midnight in the elder's timezone.
  coverDaysOfWeek  Int[] @default([]) @map("cover_days_of_week")
  coverStartMinute Int?  @map("cover_start_minute") @db.SmallInt
  coverEndMinute   Int?  @map("cover_end_minute") @db.SmallInt

  elder     User @relation("assignmentElder", fields: [elderlyId], references: [id], onDelete: Cascade)
  responder User @relation("assignmentResponder", fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([elderlyId, responderId], name: "no_duplicate_contact")
  @@index([elderlyId, priorityOrder])
  @@index([responderId])
  @@map("care_assignments")
}

// ---------------------------------------------------------------------------
// emergency_events. The emergency itself, its state, and who owns it.
// ---------------------------------------------------------------------------

model EmergencyEvent {
  id        String @id @default(uuid()) @map("event_id") @db.Uuid
  elderlyId String @map("elderly_id") @db.Uuid

  /// Null until someone takes ownership, which is exactly what an unacknowledged
  /// emergency looks like in the data.
  acknowledgedBy String? @map("acknowledged_by") @db.Uuid

  // alert_location from Figure 4.4, given physical form. Captured once at trigger.
  alertLatitude     Decimal @map("alert_latitude") @db.Decimal(9, 6)
  alertLongitude    Decimal @map("alert_longitude") @db.Decimal(9, 6)
  alertAddressLabel String? @map("alert_address_label") @db.VarChar(200)

  // responder_location. A single capture at the moment of acknowledgement, not
  // background or proximity tracking.
  responderLatitude  Decimal? @map("responder_latitude") @db.Decimal(9, 6)
  responderLongitude Decimal? @map("responder_longitude") @db.Decimal(9, 6)

  state       EventState    @default(TRIGGERED)
  currentTier Int           @default(1) @map("current_tier") @db.SmallInt
  outcome     EventOutcome?

  /// EXTENSION. What happened, in the closer's own words. Required when outcome is OTHER
  /// and optional otherwise, because a HOSPITAL_TRANSFER sometimes has a detail worth
  /// keeping too.
  outcomeNote String? @map("outcome_note") @db.VarChar(300)

  /// EXTENSION. Severity band, the weighted score behind it, and the factor values
  /// that produced it, so every escalation decision stays explainable after the fact.
  severity        Severity @default(STANDARD)
  severityScore   Int      @default(0) @map("severity_score") @db.SmallInt
  severityFactors Json?    @map("severity_factors")

  /// EXTENSION. When severity was scored the second time, once the cancel window had
  /// closed and "did not cancel" could count. Null until then. Makes the review happen
  /// exactly once, whichever of the Redis timer and the sweep reaches it first.
  severityReviewedAt DateTime? @map("severity_reviewed_at") @db.Timestamptz(3)

  /// EXTENSION. When the current tier's acknowledgement window runs out.
  ///
  /// The timer itself lives in Redis, which is what makes expiry event-driven rather
  /// than polled. This column is the durable copy: if the API is down at the moment a
  /// key expires, the notification is gone forever, and without a recorded deadline
  /// that emergency would sit silently. On boot, every open event is compared against
  /// this value, so a deployment cannot swallow an escalation.
  currentTierDeadlineAt DateTime? @map("current_tier_deadline_at") @db.Timestamptz(3)

  /// EXTENSION. Set when a caregiver or family member manually requests an emergency
  /// responder, which supersedes the automatic chain and stops pending timers.
  responderRequestedAt DateTime? @map("responder_requested_at") @db.Timestamptz(3)

  triggeredAt    DateTime  @default(now()) @map("triggered_at") @db.Timestamptz(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  /// EXTENSION. When the owner reached the elder. Kept when the emergency moves on (an
  /// owner on scene may still call in a responder), so "help arrived" stays true.
  /// Only the time is kept: the positions shared on the way live in Redis and expire.
  arrivedAt      DateTime? @map("arrived_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)

  /// EXTENSION. What raised it: the elder pressing for help, or a daily check-in they
  /// did not answer. A missed check-in is held at the standard band and has no cancel
  /// window, because nobody pressed anything.
  trigger AlertTrigger @default(PANIC)

  /// EXTENSION. Community volunteers. When they were asked (once per emergency), who
  /// accepted first, and when that person accepted and arrived. A volunteer goes
  /// alongside the chain: accepting does not take the emergency on or stop escalation.
  volunteersAskedAt   DateTime? @map("volunteers_asked_at") @db.Timestamptz(3)
  volunteerId         String?   @map("volunteer_id") @db.Uuid
  volunteerAcceptedAt DateTime? @map("volunteer_accepted_at") @db.Timestamptz(3)
  volunteerArrivedAt  DateTime? @map("volunteer_arrived_at") @db.Timestamptz(3)

  elder          User            @relation("triggeredBy", fields: [elderlyId], references: [id], onDelete: Restrict)
  owner          User?           @relation("acknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  volunteer      User?           @relation("eventVolunteer", fields: [volunteerId], references: [id], onDelete: SetNull)
  notifications  Notification[]
  auditLogs      AuditLog[]
  checkIns       CheckIn[]
  volunteerCalls VolunteerCall[]

  // The escalation engine and the dashboard both query open events by state.
  @@index([state])
  @@index([elderlyId, triggeredAt])
  @@index([triggeredAt])
  @@map("emergency_events")
}

// ---------------------------------------------------------------------------
// escalation_rules. Configuration read by the escalation engine. No foreign keys,
// deliberately: it is not tied to any single event.
// ---------------------------------------------------------------------------

model EscalationRule {
  id String @id @default(uuid()) @map("rule_id") @db.Uuid

  /// EXTENSION. Severity selects which rule set applies, which is how severity
  /// changes the escalation policy rather than the content of the alert.
  severity      Severity
  tierOrder     Int      @map("tier_order") @db.SmallInt
  responderRole Role     @map("responder_role")

  /// Null means no timeout, which is correct for the last tier: an emergency
  /// responder is the end of the chain and there is nowhere left to escalate.
  timeoutSeconds Int? @map("timeout_seconds")

  /// PARALLEL dispatches this tier at the same time as the tier before it.
  dispatchMode DispatchMode @default(SEQUENTIAL) @map("dispatch_mode")

  /// True sends the SMS fallback on first dispatch instead of waiting for push
  /// delivery to fail. Used by the critical policy.
  smsFallbackImmediate Boolean @default(false) @map("sms_fallback_immediate")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([severity, tierOrder], name: "one_rule_per_tier_per_severity")
  @@map("escalation_rules")
}

// ---------------------------------------------------------------------------
// severity_factors. EXTENSION. The weighted policy, editable by an administrator,
// so the numbers behind a severity band are data rather than code.
// ---------------------------------------------------------------------------

model SeverityFactor {
  key         String   @id @db.VarChar(48)
  label       String   @db.VarChar(160)
  weight      Int      @db.SmallInt
  enabled     Boolean  @default(true)
  description String?  @db.VarChar(400)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("severity_factors")
}

// ---------------------------------------------------------------------------
// notifications. Every dispatch attempt, per recipient and channel.
// ---------------------------------------------------------------------------

model Notification {
  id          String              @id @default(uuid()) @map("notification_id") @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  recipientId String              @map("recipient_id") @db.Uuid
  channel     NotificationChannel
  status      NotificationStatus  @default(QUEUED)

  /// EXTENSION. Which rung of the chain this dispatch belongs to, so the escalation
  /// ladder can be rebuilt from the notification history alone.
  tier Int @map("tier") @db.SmallInt

  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)

  /// EXTENSION. When this recipient said they cannot attend.
  ///
  /// A separate column rather than a status value, because status records what
  /// happened to the MESSAGE and this records what the person said about it.
  /// Overwriting a delivery outcome with a response would corrupt the per-channel
  /// reliability figures, which count a delivered message as delivered whatever the
  /// answer turned out to be.
  declinedAt DateTime? @map("declined_at") @db.Timestamptz(3)

  /// EXTENSION. Provider message id and failure reason, needed to explain a failed
  /// push in the report and to avoid double-sending an SMS.
  providerMessageId String? @map("provider_message_id") @db.VarChar(160)
  failureReason     String? @map("failure_reason") @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event     EmergencyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient User           @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([recipientId, createdAt])
  @@index([status])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// audit_logs. Every state change, with the actor who caused it. Scoped to events,
// exactly as in Figure 4.4: actor_id is nullable because the system performs some
// actions, such as a timeout-driven escalation.
// ---------------------------------------------------------------------------

model AuditLog {
  id            String      @id @default(uuid()) @map("log_id") @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  actorId       String?     @map("actor_id") @db.Uuid
  action        AuditAction
  previousState EventState? @map("previous_state")
  newState      EventState? @map("new_state")

  /// EXTENSION. Structured context for the action, for example the severity factor
  /// values, the tier dispatched, or the provider error. Never contains credentials.
  detail Json?

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  event EmergencyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, occurredAt])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// consent_records. EXTENSION. Consent as data rather than a checkbox state, because
// a caregiver usually registers the elder, so the record has to say who consented on
// whose behalf, to what, and when. Withdrawal is a timestamp, never a deletion.
// ---------------------------------------------------------------------------

model ConsentRecord {
  id            String      @id @default(uuid()) @map("consent_id") @db.Uuid
  subjectId     String      @map("subject_id") @db.Uuid
  grantedById   String      @map("granted_by_id") @db.Uuid
  type          ConsentType
  granted       Boolean     @default(true)
  policyVersion String      @map("policy_version") @db.VarChar(20)

  /// Relationship of the grantor to the subject as stated at the time, for example
  /// "self" or "primary caregiver".
  grantorRelationship String @map("grantor_relationship") @db.VarChar(60)

  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(3)

  subject   User @relation("consentSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  grantedBy User @relation("consentGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([subjectId, type])
  @@map("consent_records")
}

// ---------------------------------------------------------------------------
// chain_invitations. EXTENSION. A place in an elder's escalation chain held for
// somebody who has not signed up yet. A caregiver adds a family member by phone
// number; if nobody has that number, the invitation waits here, and signing up with
// that number turns it into a care assignment. Deleted once claimed.
// ---------------------------------------------------------------------------

model ChainInvitation {
  id            String   @id @default(uuid()) @map("invitation_id") @db.Uuid
  elderlyId     String   @map("elderly_id") @db.Uuid
  phone         String   @db.VarChar(20)
  /// What the caregiver called them, shown in the chain until they sign up.
  name          String?  @db.VarChar(120)
  /// The rank they will take in the chain, held for them so a sign-up as either
  /// caregiver or family member lands in the place the caregiver chose.
  priorityOrder Int      @map("priority_order") @db.SmallInt
  invitedById   String   @map("invited_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  elder     User @relation("invitationElder", fields: [elderlyId], references: [id], onDelete: Cascade)
  invitedBy User @relation("invitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([elderlyId, phone])
  @@index([phone])
  @@map("chain_invitations")
}

/// EXTENSION. Choices a person makes about how they help, one row per person, created
/// the first time one is changed. A missing row means every default.
///
/// Columns rather than a key-value bag, so each choice has a type, a default and a
/// migration that says when it arrived.
model UserPreference {
  userId String @id @map("user_id") @db.Uuid

  /// Share my position with the elder's care circle while I am on my way to an
  /// emergency I took on. Off until the person turns it on.
  shareWayThere Boolean @default(false) @map("share_way_there")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// EXTENSION. What raised an emergency.
enum AlertTrigger {
  /// The elder pressed for help.
  PANIC
  /// The elder did not answer a daily check-in in time.
  MISSED_CHECK_IN

  @@map("alert_trigger")
}

/// EXTENSION. Where one daily check-in got to.
enum CheckInStatus {
  /// Asked, and waiting for the elder.
  PENDING
  /// The elder said they were all right.
  ANSWERED
  /// Not answered in time; an alert was raised.
  MISSED

  @@map("check_in_status")
}

/// EXTENSION. A daily "are you all right?" for an elder who chose it, or whose circle set
/// it up and who then agreed. One per elder.
model CheckInSchedule {
  elderId String @id @map("elder_id") @db.Uuid

  enabled Boolean @default(true)

  /// Minutes after local midnight, in the elder's own time zone (users.timezone), one per
  /// check-in a day. 540 is 09:00.
  times Int[]

  /// How long the elder has to answer before their circle is alerted. A reminder goes at
  /// half of it.
  graceMinutes Int @default(30) @map("grace_minutes")

  /// Who set it up last: the elder, or somebody in their chain.
  setById String? @map("set_by_id") @db.Uuid

  /// When the elder agreed. Set at once when they set it up themselves; null while a set
  /// up by somebody else waits for them, and nothing is sent until it is set.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  elder User  @relation("checkInScheduleElder", fields: [elderId], references: [id], onDelete: Cascade)
  setBy User? @relation("checkInScheduleSetBy", fields: [setById], references: [id], onDelete: SetNull)

  @@map("check_in_schedules")
}

/// EXTENSION. One check-in: asked at dueAt, reminded at remindAt, missed at deadlineAt.
model CheckIn {
  id      String @id @default(uuid()) @map("check_in_id") @db.Uuid
  elderId String @map("elder_id") @db.Uuid

  dueAt      DateTime @map("due_at") @db.Timestamptz(3)
  remindAt   DateTime @map("remind_at") @db.Timestamptz(3)
  deadlineAt DateTime @map("deadline_at") @db.Timestamptz(3)

  status     CheckInStatus @default(PENDING)
  remindedAt DateTime?     @map("reminded_at") @db.Timestamptz(3)
  answeredAt DateTime?     @map("answered_at") @db.Timestamptz(3)
  /// "app" or "sms".
  answeredVia String?   @map("answered_via") @db.VarChar(8)
  missedAt    DateTime? @map("missed_at") @db.Timestamptz(3)

  /// The alert raised when it was missed.
  eventId String? @map("event_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  elder User            @relation(fields: [elderId], references: [id], onDelete: Cascade)
  event EmergencyEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // One check-in per elder per due time, which is what makes a second API instance, or
  // a tick that overlaps the last, harmless.
  @@unique([elderId, dueAt])
  @@index([status, deadlineAt])
  @@map("check_ins")
}

// ---------------------------------------------------------------------------
// Community volunteers. EXTENSION.
// ---------------------------------------------------------------------------

enum VolunteerStatus {
  /// Applied, not yet looked at. Never asked.
  PENDING
  APPROVED
  REJECTED
  /// Approved once, stopped by an administrator. Never asked.
  SUSPENDED

  @@map("volunteer_status")
}

/// What a volunteer says they can do. Declared, checked by an administrator off the
/// system; no certificate or ID number is stored.
enum VolunteerTraining {
  FIRST_AID
  CPR
  COMMUNITY_HEALTH_PROMOTER
  HEALTH_PROFESSIONAL
  OTHER

  @@map("volunteer_training")
}

enum VolunteerCallStatus {
  ASKED
  ACCEPTED
  DECLINED
  /// Somebody else accepted, or the emergency ended, before this volunteer answered.
  STOOD_DOWN
  /// Accepted, then could not go.
  WITHDRAWN

  @@map("volunteer_call_status")
}

/// A volunteer's application and standing. Their home area is the user's coverage
/// columns, the same physical form an emergency responder's area takes.
model VolunteerProfile {
  userId             String              @id @map("user_id") @db.Uuid
  status             VolunteerStatus     @default(PENDING)
  training           VolunteerTraining[]
  /// What "other" means, or anything the volunteer wants the reviewer to know.
  note               String?             @db.VarChar(300)
  /// Asked only while true, and only while approved.
  available          Boolean             @default(false)
  availableChangedAt DateTime?           @map("available_changed_at") @db.Timestamptz(3)
  appliedAt          DateTime            @default(now()) @map("applied_at") @db.Timestamptz(3)
  reviewedAt         DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  reviewedById       String?             @map("reviewed_by_id") @db.Uuid
  reviewNote         String?             @map("review_note") @db.VarChar(300)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User  @relation("volunteerProfile", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("volunteerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, available])
  @@map("volunteer_profiles")
}

/// One volunteer asked about one emergency, and what they said.
model VolunteerCall {
  id             String              @id @default(uuid()) @map("volunteer_call_id") @db.Uuid
  eventId        String              @map("event_id") @db.Uuid
  volunteerId    String              @map("volunteer_id") @db.Uuid
  /// From the centre of the volunteer's area to the alert, rounded to 10 m. What the
  /// volunteer is told before accepting, in place of where.
  distanceMetres Int                 @map("distance_metres")
  status         VolunteerCallStatus @default(ASKED)
  askedAt        DateTime            @default(now()) @map("asked_at") @db.Timestamptz(3)
  /// "push", "sms" or "none".
  askedVia       String              @map("asked_via") @db.VarChar(8)
  respondedAt    DateTime?           @map("responded_at") @db.Timestamptz(3)
  arrivedAt      DateTime?           @map("arrived_at") @db.Timestamptz(3)

  event     EmergencyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer User           @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([eventId, volunteerId])
  @@index([volunteerId, askedAt])
  @@map("volunteer_calls")
}
