<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MzaziCare</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mzazicare</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- App Transport Security refuses plain HTTP, and the development API is plain
	     HTTP on this machine. NSAllowsLocalNetworking permits it for local addresses
	     only: it does not open the app to arbitrary unencrypted traffic, so a release
	     build still cannot talk to an unencrypted server on the internet. -->
	<!-- iOS asks the person's permission before an app may reach other devices on the
	     Wi-Fi network, and refuses the connection outright if the app has not said why
	     it wants to. This is what a real phone needs to talk to the API running on a
	     development machine; it has no effect on a deployed build talking to a server
	     over the internet. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>When you take an emergency on and have turned on Share my way there, MzaziCare shares where you are with the elder's care circle until you arrive, so they know how long you will be.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>MzaziCare only asks for your location while the app is in use. Sharing your way there carries on behind a maps app until you arrive, and never starts on its own.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>During an emergency, MzaziCare uses the microphone so you can talk with the person coming to help. Nothing you say is recorded.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MzaziCare connects to the MzaziCare server running on your development machine so the app can be tested before it is deployed.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Declared so the call button can ask whether a tel: link will open before trying
	     it. A simulator and a Wi-Fi-only iPad cannot place calls; knowing that lets the
	     app show the number to dial by hand instead of a button that silently does
	     nothing. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
	</array>
</dict>
</plist>
