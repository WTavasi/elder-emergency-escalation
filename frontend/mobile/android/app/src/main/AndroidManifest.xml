<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared in the main manifest, not only the debug one. This app talks to an
         API; a release build without it would install and then fail at the first
         request, which is a fault nobody finds until it is in somebody's hands. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13 and later ask before an app may show notifications. The app asks
         once, after sign-in, and only in a build that was given a Firebase project. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- "Share my way there", for a responder on their way to an emergency they took
         on. Asked only when they turn that on, never on an elder's phone. Precise
         location so arriving can be recognised within 100 m; coarse with it, because
         Android 12 and later let the person choose approximate instead. No background
         location permission: sharing starts while the app is open and carries on behind
         a maps app through the plugin's foreground service, which declares its own
         FOREGROUND_SERVICE_LOCATION and shows a notification while it runs. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Talking through the app during an emergency. The microphone is opened only in a
         call: for a responder who pressed "Talk to Grace", and for the elder once
         somebody in their circle started one. The rest let the call use a headset and
         follow the network as it changes. No camera: calls are voice only. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <application
        android:label="MzaziCare"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The dialer. From Android 11 an app cannot see other apps unless it declares
             what it intends to ask them for, and the call button checks that something
             can handle a tel: link before opening it. Without this the check fails on a
             phone that plainly has a dialer, and the button does nothing.
             VIEW rather than DIAL, because VIEW is the intent url_launcher builds when it
             checks and opens a tel: link. Declaring a different action than the one
             actually asked about is how that check comes back false. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
