<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon, from frontend/brand: MzaziCare's red with the care rings from the
     corner as the background, the white M as the foreground, and the M alone for the
     themed icons of Android 13 and later. The M sits inside the circle no phone crops. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
