<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen Help button: the emergency red, because pressing it asks for a person. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
    <TextView
        android:id="@+id/help_widget_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/help_widget_background"
        android:contentDescription="@string/help_widget_description"
        android:gravity="center"
        android:text="@string/help_widget_label"
        android:textColor="@color/help_on_emergency"
        android:textSize="28sp" />
</FrameLayout>
