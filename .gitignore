frontend/mobile/android/local.properties
frontend/mobile/android/key.properties

# Firebase client configuration. Not a secret in the way a service account is, since it
# ships inside the built app, but it names the project and its API keys, and this
# repository keeps every credential out by default rather than by exception. Download
# them from the Firebase console; docs/running.md says how.
frontend/mobile/android/app/google-services.json
frontend/mobile/ios/Runner/GoogleService-Info.plist
frontend/mobile/lib/firebase_options.dart

# test and coverage
coverage/
.nyc_output/

# editors and os
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
*.swp

# logs
*.log
npm-debug.log*
