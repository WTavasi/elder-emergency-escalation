# dependencies
node_modules/
.pnp/
.pnp.js

# generated token outputs (rebuilt by `npm run tokens:build`)
packages/tokens/dist/
packages/tokens/lib/src/tokens.dart
packages/tokens/.dart_tool/
packages/tokens/pubspec.lock

# build output
dist/
build/
*.tsbuildinfo

# environment and secrets, never commit these
.env
.env.*
!.env.example
credentials/
*-service-account*.json
*.pem
*.p8
*.keystore
*.jks

# flutter / dart
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Flutter/flutter_export_environment.sh
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/key.properties

# Firebase client configuration. Not a secret in the way a service account is, since it
# ships inside the built app, but it names the project and its API keys, and this
# repository keeps every credential out by default rather than by exception. Download
# them from the Firebase console; docs/running.md says how.
apps/mobile/android/app/google-services.json
apps/mobile/ios/Runner/GoogleService-Info.plist
apps/mobile/lib/firebase_options.dart

# test and coverage
coverage/
.nyc_output/

# editors and os
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
*.swp

# logs
*.log
npm-debug.log*
