### MzaziCare API
#
# Every endpoint, in the order an emergency actually moves through them. Install the
# REST Client extension (humao.rest-client) and a "Send Request" link appears above each
# block. Responses open beside the request, which makes this a better demonstration
# surface than a terminal full of curl.
#
# Start the services and the API first:
#   docker compose up -d
#   npm run dev
#
# @name blocks capture a response so later requests can use it. Run them top to bottom.

@baseUrl = http://localhost:3000/api/v1
@password = Dev!2026

# Seeded accounts. Grace is the elder, Mary her caregiver, Aisha her daughter.
@elderPhone = +254700000010
@caregiverPhone = +254700000020
@familyPhone = +254700000030
@adminPhone = +254700000001

###############################################################################
# Health. Reports Postgres and Redis separately, and returns 503 if either is down.
###############################################################################

GET http://localhost:3000/health

###############################################################################
# 1. Sign in as the elder
###############################################################################

# @name elderLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "phone": "{{elderPhone}}", "password": "{{password}}" }

###

@elderToken = {{elderLogin.response.body.accessToken}}

GET {{baseUrl}}/auth/me
Authorization: Bearer {{elderToken}}

###############################################################################
# 2. Raise an emergency
#
# The response carries the severity band, the score, and the factor breakdown that
# produced it. That breakdown is the evidence that severity is a policy rather than a
# guess, so it is worth reading aloud during a demonstration.
###############################################################################

# @name alert
POST {{baseUrl}}/alerts
Authorization: Bearer {{elderToken}}
Content-Type: application/json

{
  "latitude": -1.2833,
  "longitude": 36.7833,
  "addressLabel": "Kileleshwa, Nairobi"
}

###

@eventId = {{alert.response.body.id}}

###############################################################################
# 3. The same alert, raised away from home
#
# Adds ten points for being away from the registered address. Run both and compare the
# severityScore field.
###############################################################################

POST {{baseUrl}}/alerts
Authorization: Bearer {{elderToken}}
Content-Type: application/json

{ "latitude": -1.268, "longitude": 36.811, "addressLabel": "Westlands, Nairobi" }

###############################################################################
# 4. Cancel inside the grace window
#
# Only the elder can cancel, and only within ten seconds. Run this straight after
# creating an alert or it will refuse, which is itself worth demonstrating.
###############################################################################

POST {{baseUrl}}/alerts/{{eventId}}/cancel
Authorization: Bearer {{elderToken}}

###############################################################################
# 5. Sign in as the caregiver
###############################################################################

# @name caregiverLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "phone": "{{caregiverPhone}}", "password": "{{password}}" }

###

@caregiverToken = {{caregiverLogin.response.body.accessToken}}

###############################################################################
# 6. What the caregiver can see
#
# Scoped to the elders whose chains they belong to. An emergency they are not part of
# returns not found rather than forbidden, so the API cannot be used to discover which
# emergencies exist.
###############################################################################

GET {{baseUrl}}/alerts
Authorization: Bearer {{caregiverToken}}

###

GET {{baseUrl}}/alerts?open=true
Authorization: Bearer {{caregiverToken}}

###

GET {{baseUrl}}/alerts/{{eventId}}
Authorization: Bearer {{caregiverToken}}

###############################################################################
# 7. Reopen a cancelled alert
#
# For the case where a caregiver is told an alert was cancelled, calls to check, and
# nobody answers. Restarts the chain at that person's own tier.
###############################################################################

POST {{baseUrl}}/alerts/{{eventId}}/reopen
Authorization: Bearer {{caregiverToken}}
Content-Type: application/json

{ "reason": "Called twice, no answer" }

###############################################################################
# 8. Acknowledge, with one location capture
#
# Stops every pending timer for this emergency. A second acknowledgement is refused.
###############################################################################

POST {{baseUrl}}/alerts/{{eventId}}/acknowledge
Authorization: Bearer {{caregiverToken}}
Content-Type: application/json

{ "latitude": -1.2841, "longitude": 36.7822 }

###############################################################################
# 9. Call in an emergency responder directly
#
# Supersedes the automatic chain: clears pending timers and dispatches the responder
# tier now, rather than after the tiers in between have each waited out their window.
###############################################################################

POST {{baseUrl}}/alerts/{{eventId}}/request-responder
Authorization: Bearer {{caregiverToken}}

###############################################################################
# 10. Resolve with a recorded outcome
#
# One of: FALSE_ALARM, CANCELLED_BY_ELDER, HANDLED_AT_HOME, RESPONDER_ATTENDED,
# HOSPITAL_TRANSFER, NO_RESPONSE
###############################################################################

POST {{baseUrl}}/alerts/{{eventId}}/resolve
Authorization: Bearer {{caregiverToken}}
Content-Type: application/json

{ "outcome": "HANDLED_AT_HOME" }

###############################################################################
# 11. Access control, worth demonstrating deliberately
###############################################################################

# No token at all
GET {{baseUrl}}/alerts

###

# A caregiver trying to raise an alert. Only the person being cared for may do that.
POST {{baseUrl}}/alerts
Authorization: Bearer {{caregiverToken}}
Content-Type: application/json

{ "latitude": -1.2833, "longitude": 36.7833 }

###

# Wrong password and unknown number answer identically, so the endpoint cannot be used
# to discover who is registered. Compare the two responses.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "phone": "{{caregiverPhone}}", "password": "wrong-password" }

###

POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "phone": "+254799999999", "password": "wrong-password" }

###############################################################################
# 12. Session handling
###############################################################################

# @name refreshed
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{caregiverLogin.response.body.refreshToken}}" }

###

# Replaying the first refresh token now fails, and revokes every session for that user,
# because a token that verifies but no longer matches has already been spent.
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{caregiverLogin.response.body.refreshToken}}" }

###

POST {{baseUrl}}/auth/logout
Authorization: Bearer {{caregiverToken}}

###############################################################################
# 13. What the administrator dashboard reads
#
# These are the only endpoints the dashboard calls. Running them here shows that the
# console displays the API's answers rather than computing anything of its own.
###############################################################################

# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "phone": "{{adminPhone}}", "password": "{{password}}" }

###

@adminToken = {{adminLogin.response.body.accessToken}}

# The live board. An administrator is scoped to every elder, which is the one thing
# this role can do that no other role can.
GET {{baseUrl}}/alerts?open=true&limit=200
Authorization: Bearer {{adminToken}}

###

# The history view, narrowed the way the filter controls narrow it.
GET {{baseUrl}}/alerts?state=ESCALATED&severity=CRITICAL&limit=50
Authorization: Bearer {{adminToken}}

###

# An unrecognised state is refused here rather than reaching the database.
GET {{baseUrl}}/alerts?state=NOT_A_STATE
Authorization: Bearer {{adminToken}}

###

# One emergency in full: the care chain, the audit trail and every delivery attempt.
# Replace the id with one from the list above.
GET {{baseUrl}}/alerts/{{raised.response.body.id}}
Authorization: Bearer {{adminToken}}

###

# The reporting figures. Median and mean response time, how far emergencies climbed,
# and the per-channel delivery rates that justify the SMS fallback.
GET {{baseUrl}}/dashboard/overview?days=30
Authorization: Bearer {{adminToken}}

###############################################################################
# 14. What the dashboard cannot do
#
# An administrator oversees emergencies; they do not take ownership of one. The API
# refuses all three actions for this account, which is why the console has no buttons
# for them. This is enforcement, not a hidden control.
###############################################################################

# Expect 403. An administrator is not part of this elder's care chain.
POST {{baseUrl}}/alerts/{{raised.response.body.id}}/acknowledge
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

###

# Expect 403 for the same reason.
POST {{baseUrl}}/alerts/{{raised.response.body.id}}/request-responder
Authorization: Bearer {{adminToken}}

###

# Expect 403. A caregiver account, by contrast, is refused the reporting endpoint,
# because that one is restricted by role rather than by care relationship.
GET {{baseUrl}}/dashboard/overview
Authorization: Bearer {{caregiverToken}}

###############################################################################
# 15. Declining
#
# A tier's timeout bounds how long an unanswered emergency waits. It should not make
# somebody who already knows they cannot attend sit out the rest of it.
###############################################################################

# Raise one to decline. Run the elder login block above first if the token expired.
# @name toDecline
POST {{baseUrl}}/alerts
Authorization: Bearer {{elderToken}}
Content-Type: application/json

{ "latitude": -1.2833, "longitude": 36.7833, "addressLabel": "Kileleshwa, Nairobi" }

###

# Mary was asked at tier one, so Mary may decline. The emergency escalates at once
# rather than waiting out the remaining window.
POST {{baseUrl}}/alerts/{{toDecline.response.body.id}}/decline
Authorization: Bearer {{caregiverToken}}
Content-Type: application/json

{ "reason": "Two hours away, cannot reach her" }

###

# Expect 200 and no second audit entry. A retry from a phone with one bar of signal
# is not a failure, so declining twice is idempotent.
POST {{baseUrl}}/alerts/{{toDecline.response.body.id}}/decline
Authorization: Bearer {{caregiverToken}}
Content-Type: application/json

{}

###

# Expect 403. Aisha is tier two and was not asked at tier one, so she cannot decline
# on tier one's behalf. Being asked is what confers the right to decline.
POST {{baseUrl}}/alerts/{{raised.response.body.id}}/decline
Authorization: Bearer {{familyToken}}
Content-Type: application/json

{}

###

# Expect 409 once somebody has taken ownership. Declining an emergency that is being
# handled is meaningless, and allowing it would let a decline undo an acknowledgement.
POST {{baseUrl}}/alerts/{{raised.response.body.id}}/decline
Authorization: Bearer {{caregiverToken}}
Content-Type: application/json

{}
